   "source": [
    "# Notebook 00: Environment & Hardware Capabilities Check\n",
    "\n",
    "This notebook verifies Python, PyTorch, CUDA GPU availability, NetCDF/Xarray, and core dependencies for **OceanEmbed**.\n",
    "Compatible with both **Local Linux Environment** and **Google Colab GPU**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "\n",
    "# Detect execution environment (Google Colab vs Local)\n",
    "try:\n",
    "    import google.colab\n",
    "    IN_COLAB = True
   "except ImportError:\n",
    "    IN_COLAB = False\n",
    "\n",
    "print(f\"Execution Environment: {'Google Colab' if IN_COLAB else 'Local Environment'}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import numpy as np
   "import xarray as xr\n",
    "import pandas as pd\n",
    "import scipy\n",
    "import dask\n",
    "import netCDF4\n",
    "import matplotlib\n",
    "\n",
    "print(f\"Python Version:     {sys.version.split()[0]}\")\n",
    "print(f\"PyTorch Version:    {torch.__version__}\")\n",
    "print(f\"CUDA Available:     {torch.cuda.is_available()}\")\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    device_name = torch.cuda.get_device_name(0)\n",
    "    print(f\"GPU Name:           {device_name}\")\n",
    "    print(f\"GPU Memory:         {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB\")\n",
    "else:\n",
    "    print(\"GPU Status:         No CUDA GPU detected (running on CPU)\")\n",
    "\n",
    "print(f\"Xarray Version:     {xr.__version__}\")\n",
    "print(f\"NumPy Version:      {np.__version__}\")\n",
    "print(f\"netCDF4 Version:    {netCDF4.__version__}\")\n",
    "print(f\"Dask Version:       {dask.__version__}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Overall environment status report\n",
    "status = \"OK\" if torch.cuda.is_available() or not IN_COLAB else \"WARNING (No GPU in Colab)\"\n",
    "print(f\"Environment Verification Status: {status}\")"
   ]
  }
 ],
